rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/saves/current {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'gameJSON', 'updatedAt'])
          && request.resource.data.keys().hasAll(['schemaVersion', 'gameJSON', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.gameJSON is string
          && request.resource.data.gameJSON.size() > 0
          && request.resource.data.gameJSON.size() <= 900000
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && validSave();
      // Uses the existing document, with no extra rule-side document reads.
      allow update: if owner() && validSave()
        && request.time >= resource.data.updatedAt + duration.value(60, 's')
        && request.resource.data.gameJSON != resource.data.gameJSON;
      // No list/delete access; one stable save per user.
    }
  }
}
